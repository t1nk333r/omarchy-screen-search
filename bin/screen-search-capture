#!/usr/bin/env bash
# Capture a screen region into private runtime storage and optionally OCR it.
# Prints exactly one JSON line on stdout; text/paths never go anywhere else.
#
#   screen-search-capture --mode circle|ocr [--lang LANGS]
#   screen-search-capture --ocr-file FILE [--lang LANGS]     (OCR an existing capture)
#
# Exit: 0 ok · 10 selection cancelled · 11 no text found · 12 OCR engine
# missing · 1 other failure.
#
# Region + freeze come from Omarchy's own picker (hyprpicker freeze + slurp
# with keyboard control and transform-aware monitor geometry), the tesseract
# invocation is omarchy-capture-text's, and the temp-file lifecycle follows
# the waydots ocr-screen-region.sh (mktemp + trap).
set -euo pipefail

PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_DIR/lib/config.sh"
source "$PLUGIN_DIR/lib/tmp.sh"

MODE=""; OCR_FILE=""; LANGS=""
while (($#)); do
  case $1 in
    --mode) MODE=$2; shift 2 ;;
    --ocr-file) OCR_FILE=$2; shift 2 ;;
    --lang) LANGS=$2; shift 2 ;;
    *) fail "unknown option: $1" 2 ;;
  esac
done

FREEZE_PID=""
SLURP_PID=""
FILE=""
KEEP_FILE=false
SEL_FILE=""
# The freeze (hyprpicker) and the region picker (slurp) are killed by PID with
# SIGKILL escalation. hyprpicker detaches into its own process group and does
# not reliably exit on SIGTERM, so a group kill or a lone TERM would leave the
# screen frozen when the shell drops this process (hide / reload / re-summon).
kill_hard() {
  local pid=$1
  [[ -n $pid ]] || return 0
  kill -TERM "$pid" 2>/dev/null || return 0
  for _ in 1 2 3; do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.05; done
  kill -KILL "$pid" 2>/dev/null || true
}
cleanup() {
  kill_hard "$SLURP_PID"
  kill_hard "$FREEZE_PID"
  [[ -n $SEL_FILE ]] && rm -f -- "$SEL_FILE"
  [[ $KEEP_FILE == true ]] || discard_capture "$FILE"
  return 0
}
trap cleanup EXIT
# On a signal, exit so the EXIT trap tears the picker down.
trap 'exit 143' TERM INT HUP

ocr_json() {
  local file=$1 kind=$2 langs text
  command -v tesseract >/dev/null || exit 12
  langs=${LANGS:-$(ocr_langs)}
  text=$(tesseract "$file" stdout --oem 1 --psm 6 -l "$langs" --dpi 300 \
           -c preserve_interword_spaces=1 2>/dev/null) || exit 1
  # Trim trailing whitespace/form-feeds tesseract appends.
  text=$(printf '%s' "$text" | sed -e 's/[[:space:]]*$//' | sed -e ':a;/^\n*$/{$d;N;ba}')
  [[ -n ${text//[[:space:]]/} ]] || exit 11
  jq -cn --arg kind "$kind" --arg file "$file" --arg text "$text" --arg langs "$langs" \
    '{kind:$kind, file:$file, text:$text, langs:$langs}'
}

if [[ -n $OCR_FILE ]]; then
  [[ -r $OCR_FILE ]] || fail "capture not found" 1
  KEEP_FILE=true
  ocr_json "$OCR_FILE" text
  exit 0
fi

[[ $MODE == circle || $MODE == ocr ]] || fail "--mode circle|ocr required" 2

sweep_captures
FILE=$(new_capture_file)
chmod 600 "$FILE"

# Freeze the screen so grim captures what the user selected, not content that
# shifted during selection. We own both PIDs from the start (unlike
# --keep-freeze, whose detached freeze can't be reached mid-selection), so
# cleanup can always tear the picker down. Mirrors omarchy-capture-text.
hyprpicker -r -z >/dev/null 2>&1 &
FREEZE_PID=$!
sleep 0.1

SEL_FILE=$(mktemp)
slurp >"$SEL_FILE" 2>/dev/null &
SLURP_PID=$!
wait "$SLURP_PID" 2>/dev/null || true
SLURP_PID=""
SELECTION=$(cat "$SEL_FILE" 2>/dev/null)
rm -f -- "$SEL_FILE"; SEL_FILE=""
# Escape / cancel yields an empty selection — not a failure.
[[ -n ${SELECTION:-} ]] || exit 10

grim -g "$SELECTION" "$FILE" || exit 1
kill_hard "$FREEZE_PID"
FREEZE_PID=""

KEEP_FILE=true
case $MODE in
  circle)
    jq -cn --arg file "$FILE" --arg geo "$SELECTION" '{kind:"image", file:$file, geometry:$geo}'
    ;;
  ocr)
    ocr_json "$FILE" text
    ;;
esac
